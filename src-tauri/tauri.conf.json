{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeTube",
  "version": "0.0.0",
  "identifier": "com.depo23.detube",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "depo23",
    "shortDescription": "YouTube without Shorts and AI slop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Video",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good"
        ],
        "recommends": [
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good"
        ],
        "recommends": [
          "gstreamer1-plugins-bad-free",
          "gstreamer1-libav"
        ]
      }
    }
  }
}
